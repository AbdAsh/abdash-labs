{
  "name": "abdash-labs",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "test": "vitest run",
    "test:functions": "deno test --allow-net --allow-env supabase/functions/",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint",
    "test:rls": "vitest run --config vitest.rls.config.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.9"
  }
}
